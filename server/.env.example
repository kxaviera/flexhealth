PORT=3000
NODE_ENV=production

# Required — use a random string of at least 32 characters
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars

# Required — change before going live
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Set true ONLY for local development
TEST_MODE=false

# Public site URL (required for PhonePe redirect). Use https:// in production.
# Cookies use Secure only when APP_URL starts with https:// (or COOKIE_SECURE=true).
APP_URL=https://flexhealth.in
# COOKIE_SECURE=true

# ── MSG91 SMS OTP (recommended for India) ──
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── PhonePe Payment Gateway ──
# From PhonePe Business / plugin settings:
#   Merchant Id     → PHONEPE_CLIENT_ID
#   Salt Key        → PHONEPE_CLIENT_SECRET
#   Salt Key Index  → PHONEPE_CLIENT_VERSION
# Checkout opens on the same page (redirect), not a popup.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox

# ── Delhivery (optional courier / AWB) ──
DELHIVERY_API_TOKEN=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=Primary
DELHIVERY_DEFAULT_WEIGHT_KG=0.5
DELHIVERY_ENV=production

# ── Shiprocket (rates, EDD, AWB) ──
# Plugin fields map to:
#   Email Id / Integration Id / Fallback & Flat rates
# Create an API user in Shiprocket → Settings → API (password required for live rates)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_INTEGRATION_ID=
SHIPROCKET_COMPANY_NAME=Flex Health
SHIPROCKET_CONTACT_FIRST=
SHIPROCKET_CONTACT_LAST=
SHIPROCKET_CONTACT_PHONE=
SHIPROCKET_REALTIME=true
SHIPROCKET_ZONE_WISE=true
SHIPROCKET_FALLBACK_TITLE=Shipping Rate
SHIPROCKET_FALLBACK_RATE=40
SHIPROCKET_FLAT_TITLE=Flat Rate
SHIPROCKET_FLAT_RATE=40
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5

# ── Firebase OTP (optional alternative to MSG91) ──
FIREBASE_AUTH=false
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Dev-only (ignored when TEST_MODE=false)
TEST_OTP=123456
TEST_PAYMENT_OTP=123456
ADMIN_PIN=1234
